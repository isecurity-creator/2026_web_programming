<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>数あてゲーム</title>
</head>

<body>
    <h1>数あてゲーム</h1>

    <!-- サーバーから送られたメッセージを表示 -->
    <p><%= message %></p>

    <% if (!finished) { %>

        <!-- 回答を入力するフォーム -->
        <form action="/guess" method="POST">
            <input type="number" name="number"
                   min="1" max="100" step="1" required>

            <button type="submit">回答する</button>
        </form>

    <% } else { %>

        <!-- 正解した場合は再挑戦するリンクを表示 -->
        <a href="/guess">もう一度遊ぶ</a>

    <% } %>

    <% if (finished) { %>
    <script>
        window.open("https://youtu.be/MFwtpM21wWc?t=57", "_blank");
    </script>
    <% } %>

</body>
</html>